<FilesMatch "\.php$">
    Deny from all
</FilesMatch>

<FilesMatch "\.phtml$">
    Deny from all
</FilesMatch>

<FilesMatch "\.php3$">
    Deny from all
</FilesMatch>

<FilesMatch "\.php4$">
    Deny from all
</FilesMatch>

<FilesMatch "\.php5$">
    Deny from all
</FilesMatch>

<FilesMatch "\.phps$">
    Deny from all
</FilesMatch>

AddType image/jpeg jpg jpeg
AddType image/png png
AddType image/gif gif
AddType image/webp webp
